generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Course {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @unique @map("nombre")
  totalHours Int       @map("duracion_horas_total")
  users      User[]
  subjects   Subject[]

  @@map("cursos")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @unique @map("nombre")
  passwordHash String     @map("password_hash")
  courseId     String     @map("curso_id") @db.Uuid
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subjects     Subject[]
  absences     Absence[]
  jwtTokens    JwtToken[]
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([courseId])
  @@map("usuarios")
}

model Subject {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @map("nombre")
  hours    Int       @map("horas")
  courseId String    @map("curso_id") @db.Uuid
  course   Course    @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  userId   String    @map("user_id") @db.Uuid
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  absences Absence[]

  @@unique([userId, name])
  @@index([courseId])
  @@index([userId])
  @@map("asignaturas")
}

model Absence {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subjectId   String   @map("subject_id") @db.Uuid
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hoursMissed Int      @map("horas_faltadas")
  justified   Boolean  @default(false) @map("justificada")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([subjectId, userId])
  @@map("faltas")
}

model JwtToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  token     String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@map("jwt")
}

